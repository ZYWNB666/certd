# ==========================================
# Certd 生产环境 Dockerfile (VIP破解版)
# ==========================================

FROM node:22-alpine AS builder
WORKDIR /workspace/

# 复制所有文件
COPY . /workspace/

# 安装 pnpm
RUN npm install -g pnpm

# ==========================================
# 关键步骤：应用 VIP + Commercial 破解
# ==========================================
# 1. 修复 package.json 的 overrides 配置
RUN sed -i 's/"@certd\/plus-core": "workspace:packages\/libs\/plus-core-mock"/"@certd\/plus-core": "workspace:*"/g' /workspace/package.json && \
    sed -i 's/"@certd\/commercial-core": "workspace:packages\/libs\/commercial-core-mock"/"@certd\/commercial-core": "workspace:*"/g' /workspace/package.json

# 2. 编译 plus-core-mock 模块
WORKDIR /workspace/packages/libs/plus-core-mock
RUN npm install --legacy-peer-deps && npx tsc

# 3. 编译 commercial-core-mock 模块
WORKDIR /workspace/packages/libs/commercial-core-mock
RUN npm install --legacy-peer-deps && npx tsc

# 4. 清理并重新安装依赖（应用 Mock 替换）
WORKDIR /workspace/
RUN rm -rf node_modules pnpm-lock.yaml
RUN pnpm install

# 5. 构建整个项目
RUN pnpm run init

# ==========================================
# 构建前端
# ==========================================
WORKDIR /workspace/packages/ui/certd-client
RUN pnpm install
RUN pnpm run build

# 复制前端构建结果到后端
RUN cp -rf dist/* ../certd-server/public/

# ==========================================
# 构建后端
# ==========================================
WORKDIR /workspace/packages/ui/certd-server
RUN pnpm install
RUN npm run build-on-docker

# ==========================================
# 生产镜像
# ==========================================
FROM node:22-alpine

# 暴露端口
EXPOSE 7001
EXPOSE 7002

# 安装必要工具（包括 pnpm 和 wget）
RUN apk add --no-cache openssl openjdk8 wget && npm install -g pnpm

WORKDIR /app/

# 复制 workspace 根目录配置（monorepo 需要）
COPY --from=builder /workspace/package.json /workspace/pnpm-workspace.yaml /workspace/pnpm-lock.yaml /app/

# 复制整个 node_modules（包含 workspace 链接）
COPY --from=builder /workspace/node_modules /app/node_modules

# 复制所有构建产物（保持 workspace 结构）
COPY --from=builder /workspace/packages /app/packages

# ==========================================
# 环境变量
# ==========================================
ENV TZ=Asia/Shanghai
ENV NODE_ENV=production
ENV MIDWAY_SERVER_ENV=production

# 下载 Lego（SSL证书工具）- 在切换目录前
ENV LEGO_VERSION=4.22.2
ENV LEGO_DOWNLOAD_DIR=/app/packages/ui/certd-server/tools/lego
RUN mkdir -p $LEGO_DOWNLOAD_DIR && \
    ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        wget -O $LEGO_DOWNLOAD_DIR/lego_v${LEGO_VERSION}_linux_amd64.tar.gz \
        https://github.com/go-acme/lego/releases/download/v${LEGO_VERSION}/lego_v${LEGO_VERSION}_linux_amd64.tar.gz; \
    elif [ "$ARCH" = "aarch64" ]; then \
        wget -O $LEGO_DOWNLOAD_DIR/lego_v${LEGO_VERSION}_linux_arm64.tar.gz \
        https://github.com/go-acme/lego/releases/download/v${LEGO_VERSION}/lego_v${LEGO_VERSION}_linux_arm64.tar.gz; \
    else \
        echo "Unsupported architecture: $ARCH"; \
    fi

# 切换到 server 目录
WORKDIR /app/packages/ui/certd-server

# ==========================================
# 健康检查
# ==========================================
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:7001/ || exit 1

# ==========================================
# 启动命令
# ==========================================
CMD ["npm", "run", "start"]

# ==========================================
# 标签信息
# ==========================================
LABEL maintainer="certd-vip-cracked" \
      description="Certd with VIP features unlocked" \
      version="1.37.10-vip"

